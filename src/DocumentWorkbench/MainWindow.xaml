<Window x:Class="DocumentWorkbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文档1" Height="760" Width="1080"
        Background="#E9EBEE" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="导入小说(_I)..." Click="ImportNovel_Click"/>
                <MenuItem Header="小说资料库(_L)" Click="OpenLibrary_Click"/>
                <Separator/>
                <MenuItem Header="新建普通文档(_N)" Click="NewEditorDoc_Click"/>
                <MenuItem Header="打开文本文档(_O)..." Click="OpenTextFile_Click"/>
                <MenuItem Header="保存文本文档(_S)" Click="SaveTextFile_Click"/>
                <Separator/>
                <MenuItem Header="返回小说阅读(_B)" Click="ReturnToReading_Click"/>
                <MenuItem Header="退出(_X)" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="编辑(_E)">
                <MenuItem Command="ApplicationCommands.Undo"/>
                <MenuItem Command="ApplicationCommands.Redo"/>
                <Separator/>
                <MenuItem Command="ApplicationCommands.Cut"/>
                <MenuItem Command="ApplicationCommands.Copy"/>
                <MenuItem Command="ApplicationCommands.Paste"/>
                <Separator/>
                <MenuItem Command="ApplicationCommands.SelectAll"/>
            </MenuItem>
            <MenuItem Header="视图(_V)">
                <MenuItem Header="放大(_I)" Click="ZoomIn_Click"/>
                <MenuItem Header="缩小(_O)" Click="ZoomOut_Click"/>
                <MenuItem Header="重置缩放(_R)" Click="ZoomReset_Click"/>
                <Separator/>
                <MenuItem x:Name="ToggleToolBarItem" Header="显示工具栏" IsCheckable="True" IsChecked="True" Click="ToggleToolBar_Click"/>
                <MenuItem x:Name="ToggleStatusBarItem" Header="显示状态栏" IsCheckable="True" IsChecked="True" Click="ToggleStatusBar_Click"/>
            </MenuItem>
            <MenuItem Header="工具(_T)">
                <MenuItem Header="设置(_S)..." Click="OpenSettings_Click"/>
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="快捷键说明(_K)..." Click="HelpKeys_Click"/>
                <MenuItem Header="关于(_A)..." Click="About_Click"/>
            </MenuItem>
        </Menu>

        <ToolBarTray x:Name="MainToolBarTray" DockPanel.Dock="Top">
            <ToolBar Band="0" BandIndex="0">
                <Label Content="字体" Padding="4,3,2,3"/>
                <ComboBox x:Name="FontFamilyCombo" Width="130" VerticalContentAlignment="Center"
                          SelectionChanged="FontFamilyCombo_SelectionChanged"/>
                <Label Content="字号" Padding="8,3,2,3"/>
                <ComboBox x:Name="FontSizeCombo" Width="64" IsEditable="True" VerticalContentAlignment="Center"
                          SelectionChanged="FontSizeCombo_SelectionChanged" LostFocus="FontSizeCombo_LostFocus"/>
                <Label Content="缩放" Padding="8,3,2,3"/>
                <ComboBox x:Name="ZoomCombo" Width="72" IsEditable="True" VerticalContentAlignment="Center"
                          SelectionChanged="ZoomCombo_SelectionChanged" LostFocus="ZoomCombo_LostFocus"/>
                <Separator/>
                <Label Content="每次按键显示" Padding="8,3,2,3"/>
                <ComboBox x:Name="CharsPerKeyCombo" Width="56" VerticalContentAlignment="Center"
                          SelectionChanged="CharsPerKeyCombo_SelectionChanged"/>
                <Label Content="字" Padding="2,3,8,3"/>
                <Separator/>
                <Button x:Name="PauseButton" Content="暂停 (F2)" Margin="4,0" Padding="8,2" Click="PauseToggle_Click"/>
                <Button Content="资料库" Margin="4,0" Padding="8,2" Click="OpenLibrary_Click"/>
                <Button Content="设置" Margin="4,0" Padding="8,2" Click="OpenSettings_Click"/>
            </ToolBar>
        </ToolBarTray>

        <StatusBar x:Name="MainStatusBar" DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusModeText" Text="就绪"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="StatusProgressText" Text=""/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="StatusHintText" Text="" Foreground="#666666"/>
            </StatusBarItem>
        </StatusBar>

        <ScrollViewer x:Name="PageScrollViewer" Background="#E2E4E8"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center" Margin="0,16,0,32">
                <Border x:Name="PageBorder" Background="White" Width="794" MinHeight="1123"
                        Padding="96,86" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="1" Direction="270" Opacity="0.22" Color="#404040"/>
                    </Border.Effect>
                    <RichTextBox x:Name="PageTextBox"
                             BorderThickness="0" Background="Transparent"
                             IsReadOnly="True" IsReadOnlyCaretVisible="True"
                             VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden"
                             Foreground="#1F1F1F" CaretBrush="#1F1F1F"
                             FontFamily="等线" FontSize="16"
                             SizeChanged="PageTextBox_SizeChanged"
                             PreviewKeyDown="PageTextBox_PreviewKeyDown"
                             PreviewTextInput="PageTextBox_PreviewTextInput">
                        <FlowDocument LineHeight="24"/>
                    </RichTextBox>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

<Window x:Class="DocumentWorkbench.Views.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小说资料库" Height="660" Width="1000"
        WindowStartupLocation="CenterOwner" Background="#F5F6F7"
        Closing="Window_Closing">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="导入小说..." Padding="10,4" Click="Import_Click"/>
            <Button Content="开始阅读" Padding="10,4" Margin="8,0,0,0" Click="Read_Click"/>
            <Button Content="重命名" Padding="10,4" Margin="8,0,0,0" Click="Rename_Click"/>
            <Button Content="标签" Padding="10,4" Margin="8,0,0,0" Click="Tags_Click"/>
            <Button Content="重新定位文件..." Padding="10,4" Margin="8,0,0,0" Click="Relocate_Click"/>
            <Button Content="删除" Padding="10,4" Margin="8,0,0,0" Click="Delete_Click"/>
            <TextBlock Text="搜索:" VerticalAlignment="Center" Margin="16,0,4,0"/>
            <TextBox x:Name="SearchBox" Width="170" VerticalContentAlignment="Center" TextChanged="SearchBox_Changed"/>
            <TextBlock Text="排序:" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <ComboBox x:Name="SortCombo" Width="110" VerticalContentAlignment="Center" SelectedIndex="0" SelectionChanged="SortCombo_Changed">
                <ComboBoxItem Content="按名称"/>
                <ComboBoxItem Content="按最近阅读"/>
                <ComboBoxItem Content="按字数"/>
                <ComboBoxItem Content="按导入时间"/>
            </ComboBox>
        </StackPanel>

        <TextBlock x:Name="ImportModeHint" DockPanel.Dock="Top" Foreground="#5A5A5A" Margin="2,0,0,6" TextWrapping="Wrap"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <ListView x:Name="NovelList" Grid.Row="0" SelectionMode="Single"
                      SelectionChanged="NovelList_SelectionChanged" MouseDoubleClick="NovelList_DoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="名称" Width="190" DisplayMemberBinding="{Binding DisplayName}"/>
                        <GridViewColumn Header="类型" Width="56" DisplayMemberBinding="{Binding FileType}"/>
                        <GridViewColumn Header="字数" Width="80" DisplayMemberBinding="{Binding CharCount}"/>
                        <GridViewColumn Header="章节" Width="56" DisplayMemberBinding="{Binding ChapterCount}"/>
                        <GridViewColumn Header="编码" Width="90" DisplayMemberBinding="{Binding EncodingName}"/>
                        <GridViewColumn Header="标签" Width="130" DisplayMemberBinding="{Binding TagsText}"/>
                        <GridViewColumn Header="最近阅读" Width="130" DisplayMemberBinding="{Binding LastReadText}"/>
                        <GridViewColumn Header="文件" Width="220" DisplayMemberBinding="{Binding StoredPath}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <GroupBox Grid.Row="2" Header="章节与解析规则" Margin="0,4,0,0">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="自定义章节规则（正则，可留空）:" VerticalAlignment="Center"/>
                        <TextBox x:Name="PatternBox" Width="240" Margin="6,0" VerticalContentAlignment="Center"/>
                        <Button Content="重新解析章节" Padding="8,3" Click="Reparse_Click"/>
                        <Button Content="从所选章节开始阅读" Padding="8,3" Margin="12,0,0,0" Click="ReadChapter_Click"/>
                    </StackPanel>
                    <ListBox x:Name="ChapterList" DisplayMemberPath="Title"/>
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>

<Window x:Class="DocumentWorkbench.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入" Height="170" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="12">
        <TextBlock x:Name="LabelText" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <TextBox x:Name="InputBox" VerticalContentAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Width="84" Padding="0,4" Click="Ok_Click" IsDefault="True"/>
            <Button Content="取消" Width="84" Padding="0,4" Margin="8,0,0,0" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>

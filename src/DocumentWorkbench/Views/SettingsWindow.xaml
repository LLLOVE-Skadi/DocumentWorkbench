<Window x:Class="DocumentWorkbench.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DocumentWorkbench.Views"
        Title="设置" Height="740" Width="660"
        WindowStartupLocation="CenterOwner" Background="#F5F6F7">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="恢复默认设置" Padding="12,5" Click="ResetDefaults_Click"/>
            <Button Content="确定" Padding="18,5" Margin="12,0,0,0" Click="Ok_Click" IsDefault="True"/>
            <Button Content="取消" Padding="18,5" Margin="8,0,0,0" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 外观 -->
                <GroupBox Header="外观" Margin="0,0,0,8">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="窗口标题" VerticalAlignment="Center"/>
                        <TextBox x:Name="WindowTitleBox" Grid.Row="0" Grid.Column="1" Margin="0,3"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="字体" VerticalAlignment="Center"/>
                        <ComboBox x:Name="FontCombo" Grid.Row="1" Grid.Column="1" Margin="0,3" IsEditable="True"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="字号（8 - 72）" VerticalAlignment="Center"/>
                        <TextBox x:Name="FontSizeBox" Grid.Row="2" Grid.Column="1" Margin="0,3"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="行距倍数（1.0 - 3.0）" VerticalAlignment="Center"/>
                        <TextBox x:Name="LineSpacingBox" Grid.Row="3" Grid.Column="1" Margin="0,3"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="页面宽度（400 - 1600）" VerticalAlignment="Center"/>
                        <TextBox x:Name="PageWidthBox" Grid.Row="4" Grid.Column="1" Margin="0,3"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="缩放比例 %（50 - 200）" VerticalAlignment="Center"/>
                        <TextBox x:Name="ZoomBox" Grid.Row="5" Grid.Column="1" Margin="0,3"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="状态栏显示阅读进度" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ShowProgressCheck" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" Margin="0,6"/>
                    </Grid>
                </GroupBox>

                <!-- 阅读 -->
                <GroupBox Header="阅读" Margin="0,0,0,8">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="每次触发显示字符数（1 - 20）" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CharsPerKeyCombo" Grid.Row="0" Grid.Column="1" Margin="0,3" IsEditable="True"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="章节显示完毕时" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ChapterEndCombo" Grid.Row="1" Grid.Column="1" Margin="0,3"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="启动时恢复上次阅读" VerticalAlignment="Center"/>
                        <CheckBox x:Name="RestoreCheck" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,6"/>
                    </Grid>
                </GroupBox>

                <!-- 资料库 -->
                <GroupBox Header="小说资料库" Margin="0,0,0,8">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="导入方式" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ImportModeCombo" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="复制模式目录（留空为默认）" VerticalAlignment="Center"/>
                        <TextBox x:Name="LibraryFolderBox" Grid.Row="1" Grid.Column="1" Margin="0,3"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="浏览..." Padding="8,2" Margin="6,3,0,3" Click="BrowseLibraryFolder_Click"/>
                    </Grid>
                </GroupBox>

                <!-- 办公模式 -->
                <GroupBox Header="办公模式" Margin="0,0,0,8">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="办公文档路径" VerticalAlignment="Center"/>
                        <TextBox x:Name="OfficeDocBox" Grid.Row="0" Grid.Column="1" Margin="0,3"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="浏览..." Padding="8,2" Margin="6,3,0,3" Click="BrowseOfficeDoc_Click"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="打开程序（留空=系统默认）" VerticalAlignment="Center"/>
                        <TextBox x:Name="OfficeProgramBox" Grid.Row="1" Grid.Column="1" Margin="0,3"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="浏览..." Padding="8,2" Margin="6,3,0,3" Click="BrowseOfficeProgram_Click"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="切换策略" VerticalAlignment="Center"/>
                        <ComboBox x:Name="StrategyCombo" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3"/>
                    </Grid>
                </GroupBox>

                <!-- 快捷键 -->
                <GroupBox Header="快捷键" Margin="0,0,0,8">
                    <StackPanel Margin="8">
                        <CheckBox x:Name="GlobalCheck" Margin="0,2,0,8"
                                  Content="注册全局快捷键（在其他程序中也能切换；不勾选则仅在本程序前台时生效，可随时关闭）"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="切换办公模式" VerticalAlignment="Center"/>
                            <local:HotkeyCaptureBox x:Name="SwitchHotkeyBox" Grid.Row="0" Grid.Column="1" Margin="0,3"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="返回阅读模式" VerticalAlignment="Center"/>
                            <local:HotkeyCaptureBox x:Name="ReturnHotkeyBox" Grid.Row="1" Grid.Column="1" Margin="0,3"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="打开小说资料库" VerticalAlignment="Center"/>
                            <local:HotkeyCaptureBox x:Name="LibraryHotkeyBox" Grid.Row="2" Grid.Column="1" Margin="0,3"/>

                            <Separator Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="暂停 / 继续（单键）" VerticalAlignment="Center"/>
                            <local:HotkeyCaptureBox x:Name="PauseKeyBox" Grid.Row="4" Grid.Column="1" Margin="0,3"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="跳到下一段（单键）" VerticalAlignment="Center"/>
                            <local:HotkeyCaptureBox x:Name="NextParaKeyBox" Grid.Row="5" Grid.Column="1" Margin="0,3"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="回退一段（单键）" VerticalAlignment="Center"/>
                            <local:HotkeyCaptureBox x:Name="PrevParaKeyBox" Grid.Row="6" Grid.Column="1" Margin="0,3"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="重置当前章节（单键）" VerticalAlignment="Center"/>
                            <local:HotkeyCaptureBox x:Name="ResetKeyBox" Grid.Row="7" Grid.Column="1" Margin="0,3"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="上一章 / 下一章（单键）" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                <local:HotkeyCaptureBox x:Name="PrevChapterKeyBox" Width="110"/>
                                <local:HotkeyCaptureBox x:Name="NextChapterKeyBox" Width="110" Margin="8,0,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Row="9" Grid.Column="0" Text="撤销上次显示（单键）" VerticalAlignment="Center"/>
                            <local:HotkeyCaptureBox x:Name="UndoKeyBox" Grid.Row="9" Grid.Column="1" Margin="0,3"/>
                        </Grid>
                        <TextBlock Foreground="#5A5A5A" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="在输入框内直接按下需要的按键即可录入；Esc 清空。模式切换快捷键必须包含 Ctrl / Alt / Win 修饰键。"/>
                    </StackPanel>
                </GroupBox>

                <TextBlock Foreground="#5A5A5A" TextWrapping="Wrap" Margin="2,0,2,6"
                           Text="所有设置仅保存在本机（%APPDATA%\DocumentWorkbench），不会上传。小说原文不会被本程序修改。"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
